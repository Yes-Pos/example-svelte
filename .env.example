# Base URL of the YesPOS API (without a trailing slash).
YESPOS_API_BASE_URL=http://localhost:8082

# Client credential (key = "va" header, secret signs every request).
# Keep these on the server only: they are never sent to the browser.
YESPOS_CLIENT_KEY=
YESPOS_CLIENT_SECRET=

# Outlet whose products are sold. Leave empty to use the client's first outlet.
YESPOS_OUTLET_UUID=

# Optional: where YesPOS sends order status callbacks.
YESPOS_NOTIFY_URL=

# Optional: EDC terminal used when the customer pays by card (all three are
# required for the EDC option to show up).
YESPOS_EDC_APP_CODE=
YESPOS_EDC_TERMINAL_CODE=
YESPOS_EDC_MERCHANT_CODE=

# Shop name shown in the header.
PUBLIC_STORE_NAME=YesPOS Store
